# contratacion-personal-mineria · variables de entorno (copiar a .env y completar)
# El .env real NUNCA se commitea.
#
# Las credenciales de BD (DB_HOST/PORT/NAME/USER/PASSWORD) y el schema
# (DB_SCHEMA) NO van acá: ./up.sh las interpola en docker-compose.yml desde el
# catálogo central ~/config/connections.env (CONN_QA_* + CONN_QA_RECLUTAMIENTOMIN_SCHEMA).
# Si falta esa variable la app debe fallar al arrancar, jamás caer a un
# schema por default — es el único aislamiento entre plataformas en QA.

# --- WhatsApp (Evolution API) -----------------------------------------------
EVOLUTION_API_URL=http://whastapp_infrastructure-evolution-api-1:8080
EVOLUTION_API_KEY=change-me
EVOLUTION_INSTANCE=FlesanNumber

# --- Login CIA (Google, cia_auth) -------------------------------------------
# Client ID único de GCP (el mismo que combustible/alertas/debida-diligencia).
# Vacío = login inactivo (rollout seguro, no bloquea nada). Requiere que el
# origen de esta app esté agregado en "Authorized JavaScript origins" del
# Client ID en GCP.
GOOGLE_CLIENT_ID=
CIA_ALLOWED_DOMAINS=flesan.cl
# Bootstrap: solo aplica al primer login de un correo (ver usuarios.py). No
# decide el rol en logins siguientes — eso lo tiene la tabla `usuarios`.
CIA_ADMIN_EMAILS=
# openssl rand -hex 32 — propio de esta app, no se comparte con otras.
SESSION_SECRET=change-me
SESSION_TTL_HOURS=12
# En LAN sobre HTTP debe ir false (el navegador descarta cookies Secure sin TLS).
SESSION_COOKIE_SECURE=false

# --- Buzón CIA (badge/"chatbot") --------------------------------------------
CIA_FEEDBACK_URL=http://192.168.10.22:8083
# Token de servicio para el slug "cia_reclutamiento_min" en feedback-api
# (CIA_SERVICE_TOKENS). Vacío = /api/feedback responde 503 sin romper nada.
CIA_SERVICE_TOKEN=
